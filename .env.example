# Copy to .env.local. Never commit populated environment files.
# Supabase Connect > Transaction pooler (server-only). POSTGRES_URL is also accepted.
DATABASE_URL=
# Optional session/direct connection for running migrations.
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=patient-documents
CRON_SECRET=

# Optional providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
TEST_EMAIL=
TEST_WHATSAPP=

# Optional authenticated local smoke test. Use a dedicated test account.
SMOKE_EMAIL=
SMOKE_PASSWORD=
