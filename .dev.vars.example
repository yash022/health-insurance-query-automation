# Copy to .dev.vars for local development. Never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Optional approved template whose variable 1 is the rendered patient message.
TWILIO_CONTENT_SID=
# Required to send from synthetic profiles. These override profile destinations.
TEST_EMAIL=
TEST_WHATSAPP=
# Random server-only token for your scheduler; use at least 32 random bytes.
CRON_SECRET=
